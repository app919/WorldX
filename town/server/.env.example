# 三邻邦后端配置（复制为 .env 或在部署平台里配置环境变量）
NODE_ENV=production
PORT=8787
# 对外访问地址（微信回调、Cookie 校验都用它）
PUBLIC_URL=https://your-domain.example.com

# 必填：会话密钥（随机长字符串）与数据加密密钥（64 位十六进制，可用 `openssl rand -hex 32` 生成）
SESSION_SECRET=
DATA_KEY=

# 数据库与上传目录（SQLite 单文件，记得做定期备份）
DB_PATH=/data/sanlinbang.db
UPLOAD_DIR=/data/uploads

# 初始管理员手机号（逗号分隔）：这些手机号登录后自动成为管理员
ADMIN_PHONES=

# 短信：aliyun 或 tencent（生产环境必须二选一；console 仅开发用）
SMS_PROVIDER=tencent
# 腾讯云短信（新用户有免费试用条数）
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SMS_APP_ID=
TENCENT_SMS_SIGN=
TENCENT_SMS_TEMPLATE=
# 阿里云短信
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN=
ALIYUN_SMS_TEMPLATE=

# 微信开放平台「网站应用」扫码登录（回调域名需在开放平台登记为 PUBLIC_URL 的域名）
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 可选：配置后用 Claude 提炼上传资料（按量付费）；不配置则使用免费的规则提炼
ANTHROPIC_API_KEY=
