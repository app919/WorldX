  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node e2e/demo-story.cjs",
    "package": "node scripts/package.mjs",
    "playtest": "node e2e/full-playtest.cjs",
    "server": "tsx watch server/src/server.ts",
    "server:start": "NODE_ENV=production tsx server/src/server.ts",
    "server:typecheck": "tsc -p server/tsconfig.json",
    "start": "npm run build && tsx server/src/server.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fastify/cookie": "^9.4.0",
    "@fastify/multipart": "^8.3.1",
    "@fastify/static": "^7.0.4",
    "@react-three/drei": "^9.117.3",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.16.6",
    "fastify": "^4.29.1",
    "framer-motion": "^11.11.17",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "pdf-parse": "^1.1.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "zod": "^3.25.76",
    "zustand": "^4.5.5"
